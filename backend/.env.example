# =============================================
# MGTS Backend - Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mgts_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="MGTS Platform <noreply@mgts.com>"

# Frontend URL (for email links + CORS)
CLIENT_URL=http://localhost:3000

# 2FA
TWO_FA_APP_NAME=MGTS

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
